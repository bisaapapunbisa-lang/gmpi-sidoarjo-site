{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/v/:token",
      "destination": "/verifikasi"
    },
    {
      "source": "/V/:token",
      "destination": "/verifikasi"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)\\.md",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/supabase/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/uploads/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/exports/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/kop/:path*",
      "destination": "/",
      "permanent": false
    }
  ]
}
