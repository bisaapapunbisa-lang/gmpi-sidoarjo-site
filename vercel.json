{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/unduh-film",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"DPD-GMPI-Sidoarjo-Cahaya-Perjuangan-4K.mp4\""
        },
        {
          "key": "Content-Type",
          "value": "video/mp4"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/unduh-film",
      "destination": "/assets/cinema/dpd-gmpi-cinematic-4k.mp4"
    },
    {
      "source": "/v/:token",
      "destination": "/verifikasi"
    },
    {
      "source": "/V/:token",
      "destination": "/verifikasi"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)\\.md",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/supabase/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/uploads/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/exports/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/kop/:path*",
      "destination": "/",
      "permanent": false
    }
  ]
}
